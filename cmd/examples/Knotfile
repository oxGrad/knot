# Knotfile — knot dotfiles manager configuration
#
# Each entry under `packages` defines a dotfile bundle to manage.
# Run `knot tie --all` to create all symlinks.
# Run `knot tie --tag work` to tie only packages tagged "work".
# Run `knot status` to see what would change.
#
# Full reference: https://github.com/oxgrad/knot

packages:

  # source defaults to ./nvim when omitted
  # install: lets `i` in the TUI bootstrap the binary itself. brew/apt/dnf
  # names aren't listed here — autoResolve (default true) fills them in with
  # the package name below (nvim), since that matches all three managers.
  nvim:
    target: ~/.config/nvim
    tags: [work]
    ignore:
      - "*.log"
      - ".DS_Store"
    install:
      bin: nvim                     # binary checked to detect an existing install

  tmux:
    target: ~/.config/tmux
    tags: [work]
    install:
      bin: tmux
      deps: [git]                   # installed first via the same package manager

  # Zsh configuration — explicit source, tagged home
  zsh:
    source: ./zsh
    target: ~/
    tags: [home]
    ignore:
      - "README.md"

  # macOS-only: yabai window manager
  yabai:
    target: ~/.config/yabai
    tags: [home]
    condition:
      os: darwin                  # darwin | linux | windows | freebsd

  # Linux-only: i3 can belong to multiple tags
  i3:
    target: ~/.config/i3
    tags: [home, linux]
    condition:
      os: linux

  # untagged — still usable by name: knot tie secrets
  # install.script runs when there's no package-manager entry to use;
  # autoResolve: false stops brew/apt/dnf being auto-filled with "secrets"
  secrets:
    target: ~/.ssh
    install:
      bin: age
      script: curl -fsSL https://age-encryption.org/install.sh | sh
      autoResolve: false
